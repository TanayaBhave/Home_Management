# Copy this file to `.env` on the server (cp .env.example .env) and fill it in.
# docker-compose reads it via `env_file: .env`. Never commit the real .env.

# Host port the app is published on (the container always listens on 8080
# internally). Default 40001.
# Keep the `tailscale serve` target in sync with it.
APP_PORT=40001

# Shared household secret. Generate a long random string, e.g.:
#   openssl rand -base64 32
# The SAME value is entered on every phone (Settings → Access token).
SYNC_TOKEN=

# Optional: contact for Web Push (VAPID "subject"). A mailto: or https: URL.
# Push services use it only to reach you about abuse; any address you own works.
VAPID_SUBJECT=mailto:admin@example.com

# Optional: pin VAPID keys. Leave empty — the server generates a pair on first
# start and stores it in the SQLite DB. Only set these if you're migrating
# servers and want existing phone subscriptions to keep working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
